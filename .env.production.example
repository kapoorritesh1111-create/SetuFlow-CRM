# SETU Flow production environment example
# Never commit real secrets. Add these in Vercel Project Settings > Environment Variables.

# Current investor-demo scanner path.
# Use direct OpenAI Vision for camera photos because it reads the image directly.
CONTACT_SCAN_PROVIDER=openai-vision
CONTACT_SCAN_FALLBACK_PROVIDER=openai

# Keep Google Vision configured for future low-cost production comparison, but it is not used when CONTACT_SCAN_PROVIDER=openai-vision.
GOOGLE_CLOUD_VISION_API_KEY=
# Future low-cost production comparison values:
# CONTACT_SCAN_PROVIDER=google-vision
# activeProvider: google-vision+openai

# Required for OpenAI Vision direct photo reading and field extraction.
OPENAI_API_KEY=
OPENAI_CONTACT_SCAN_MODEL=gpt-4.1-mini

# Recommended explicit AI provider for other AI features.
AI_PROVIDER=openai
AI_ENABLED=true
NEXT_PUBLIC_AI_ENABLED=true

# Required for Supabase auth/data access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Recommended for QR/vCard/share links.
NEXT_PUBLIC_APP_URL=https://www.setuflowcrm.com
NEXT_PUBLIC_SITE_URL=https://www.setuflowcrm.com

# Mobile rollout flag.
NEXT_PUBLIC_FEATURE_MOBILE_APP_V1=true
FEATURE_MOBILE_APP_V1=true
