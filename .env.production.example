# SETU Flow production environment example
# Never commit real secrets. Add these in Vercel Project Settings > Environment Variables.

# Current investor-demo scanner path.
# Use direct OpenAI Vision for camera photos because it reads the image directly.
CONTACT_SCAN_PROVIDER=openai-vision
CONTACT_SCAN_FALLBACK_PROVIDER=openai

# Keep Google Vision configured for future low-cost production comparison, but it is not used when CONTACT_SCAN_PROVIDER=openai-vision.
GOOGLE_CLOUD_VISION_API_KEY=
# Future low-cost production comparison values:
# CONTACT_SCAN_PROVIDER=google-vision
# activeProvider: google-vision+openai

# Required for OpenAI Vision direct photo reading and field extraction.
OPENAI_API_KEY=
OPENAI_CONTACT_SCAN_MODEL=gpt-4.1-mini


# Setu Guru live research / GPT backend.
# Uses OpenAI Responses API with web search when SETU_GURU_LIVE_SEARCH=true.
SETU_GURU_MODEL=gpt-4.1-mini
SETU_GURU_LIVE_SEARCH=true
SETU_GURU_ALLOW_WRITEBACK=false
SETU_GURU_REQUIRE_ADMIN_APPROVAL=true

# Recommended explicit AI provider for other AI features.
AI_PROVIDER=openai
AI_ENABLED=true
NEXT_PUBLIC_AI_ENABLED=true

# Required for Supabase auth/data access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for scheduled analytics jobs in vercel.json.
# Generate with: openssl rand -base64 32
# Add this exact value to Vercel Project Settings > Environment Variables.
CRON_SECRET=your_secret_here

# Required for signed integration webhooks.
# Use WEBHOOK_SECRET_<PROVIDER> where <PROVIDER> is the connector id uppercased with non-alphanumeric characters replaced by underscores.
# Example: /api/integrations/webhooks/freight_mock expects WEBHOOK_SECRET_FREIGHT_MOCK.
WEBHOOK_SECRET_FREIGHT_MOCK=
WEBHOOK_SECRET_ERP_MOCK=

# Recommended for QR/vCard/share links.
NEXT_PUBLIC_APP_URL=https://www.setuflowcrm.com
NEXT_PUBLIC_SITE_URL=https://www.setuflowcrm.com

# Mobile rollout flag.
NEXT_PUBLIC_FEATURE_MOBILE_APP_V1=true
FEATURE_MOBILE_APP_V1=true

# Client onboarding admin notification email.
SETU_EMAIL_PROVIDER=mailtrap
MAILTRAP_API_KEY=
MAILTRAP_USE_SANDBOX=false
MAILTRAP_SANDBOX_ID=
SETU_NOTIFICATION_FROM_EMAIL=Setu Flow <help@setugroups.com>
SETU_ONBOARDING_ADMIN_EMAIL=admin@setugroups.com
# Optional fallback only if switching SETU_EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Setu-internal organization that can access /admin/client-onboarding.
SETU_INTERNAL_ORG_SLUG=setu-flow
# Optional hard lock by organization UUID if needed.
SETU_INTERNAL_ORG_ID=
