{
  "id": "/setu-mail",
  "name": "SETU Mail",
  "short_name": "SETU Mail",
  "description": "Mail, calendar and people for SETU Flow.",
  "start_url": "/mail?app=setu-mail",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#ffffff",
  "theme_color": "#0b2e4a",
  "orientation": "portrait-primary",
  "categories": ["business", "productivity", "email"],
  "icons": [
    {
      "src": "/icons/setu-mail-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/setu-mail-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Mail",
      "short_name": "Mail",
      "url": "/mail?app=setu-mail",
      "icons": [{ "src": "/icons/setu-mail-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Calendar",
      "short_name": "Calendar",
      "url": "/calendar?app=setu-mail",
      "icons": [{ "src": "/icons/setu-mail-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "People",
      "short_name": "People",
      "url": "/contacts?app=setu-mail",
      "icons": [{ "src": "/icons/setu-mail-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
