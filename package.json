{
  "name": "setu-flow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/repo-alignment.test.mjs tests/docs-consistency.test.mjs tests/routes-presence.test.mjs",
    "test:release-readiness": "npm test",
    "check:dashboard": "node scripts/check-dashboard-freeze.mjs",
    "verify": "npm run typecheck && npm run check:dashboard && npm test && npm run build",
    "release:proof": "npm run verify",
    "vercel-build": "NODE_OPTIONS=--max-old-space-size=4096 NEXT_TELEMETRY_DISABLED=1 next build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.56.0",
    "next": "^14.2.35",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22.16.0 <23",
    "npm": ">=10.9.2 <11"
  },
  "packageManager": "npm@10.9.7"
}
