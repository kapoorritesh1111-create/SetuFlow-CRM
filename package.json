{
  "name": "setu-flow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/repo-alignment.test.mjs tests/docs-consistency.test.mjs tests/routes-presence.test.mjs tests/dcc-alignment.test.mjs tests/route-contract.test.mjs tests/release-proof.test.mjs tests/mobile-route-contract.test.mjs tests/mobile-role-aware-leads.test.mjs",
    "test:release-readiness": "npm test",
    "check:dashboard": "node scripts/check-dashboard-freeze.mjs",
    "verify": "npm run clean:verification && npm run typecheck && npm run check:contracts && npm run check:dashboard && npm test && npm run build",
    "release:proof": "npm run verify",
    "clean:verification": "node scripts/clean-verification.mjs",
    "check:contracts": "node scripts/check-contract-boundaries.mjs",
    "test:pricing": "tsx --test tests/pricing/fx-resolution.helpers.test.ts tests/pricing/freight-calculation.helpers.test.ts tests/pricing/quote-compilation.helpers.test.ts tests/pricing/fx-resolution.service.test.ts tests/pricing/quote-compilation.service.test.ts",
    "test:workspace": "tsx --test tests/workspace/rls-permissions.test.ts",
    "test:orders": "tsx --test tests/orders/order-execution.test.ts",
    "test:all": "tsx --test tests/pricing/fx-resolution.helpers.test.ts tests/pricing/freight-calculation.helpers.test.ts tests/pricing/quote-compilation.helpers.test.ts tests/pricing/fx-resolution.service.test.ts tests/pricing/quote-compilation.service.test.ts tests/workspace/rls-permissions.test.ts tests/orders/order-execution.test.ts tests/integrations/governance.test.ts tests/security/rls-boundaries.test.ts tests/security/order-auth-boundaries.test.ts tests/security/rpc-grant-hardening.test.ts tests/security/db-capability-design.test.ts",
    "test:integrations": "tsx --test tests/integrations/governance.test.ts",
    "test:security": "tsx --test tests/security/rls-boundaries.test.ts tests/security/order-auth-boundaries.test.ts tests/security/rpc-grant-hardening.test.ts tests/security/db-capability-design.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.56.0",
    "next": "^14.2.35",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  }
}
