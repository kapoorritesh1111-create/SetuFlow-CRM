{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/features/integrations/interakt/workspace-v2": [
        "./src/features/integrations/interakt/workspace-v4.ts"
      ],
      "@/features/integrations/interakt/client": [
        "./src/features/integrations/interakt/client-safe.ts"
      ],
      "@/features/integrations/interakt/components/sales-message-composer": [
        "./src/features/integrations/interakt/components/sales-message-composer-safe.tsx"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    ".next",
    "node_modules"
  ]
}
