{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --no-audit --no-fund",
  "crons": [
    {
      "path": "/api/cron/analytics-snapshot",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/generate-changelog-drafts",
      "schedule": "0 8 * * 1"
    }
  ]
}
